new file mode 100644
index 00000000..4150000a
--- /dev/null
+++ b/agent/generation_speed.py
@@ -0,0 +1,82 @@
+"""Generation throughput: accepted engine tokens/time, with explicit request fallback."""
+from __future__ import annotations
+
+from collections import deque
+import math
+
+
+def _field(obj, name):
+    if isinstance(obj, dict):
+        return obj.get(name)
+    value = getattr(obj, name, None)
+    extra = getattr(obj, "model_extra", None)
+    return value if value is not None else (extra.get(name) if isinstance(extra, dict) else None)
+
+
+def _number(value, *, positive=False):
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    return float(value) if 0 <= value <= 1e100 and math.isfinite(value) and (value > 0 if positive else value >= 0) else None
+
+
+def engine_sample(response):
+    """llama.cpp timings are cumulative for this completion, not per GPU or draft proposal."""
+    timings = _field(response, "timings")
+    tokens = _number(_field(timings, "predicted_n"), positive=True)
+    millis = _number(_field(timings, "predicted_ms"), positive=True)
+    if tokens is None or millis is None or not tokens.is_integer():
+        return None
+    seconds = millis / 1000
+    return (tokens, seconds) if seconds > 0 and tokens / seconds < 1e6 else None
+
+
+def record_speed(agent, response, output_tokens, api_duration):
+    """One atomic paired sample per completed call; keep request latency separate."""
+    sample = engine_sample(response)
+    kind = "generation" if sample is not None else "request"
+    if sample is None:
+        sample = (_number(output_tokens), _number(api_duration, positive=True))
+    history = getattr(agent, "_api_speed_history", None)
+    if history is None:
+        history = agent._api_speed_history = deque(maxlen=10)
+    history.append((*sample, kind))
+
+
+def read_speed(agent):
+    """Duration-weighted rate; never mix engine decode time with full request time."""
+    history = getattr(agent, "_api_speed_history", None)
+    if history:
+        newest = history[-1][2]
+        samples = []
+        for tokens, seconds, kind in reversed(history):
+            if kind != newest:
+                break
+            if tokens is None or seconds is None:
+                return None, None
+            samples.append((tokens, seconds))
+    else:
+        latencies = list(getattr(agent, "_api_latency_history", None) or [])
+        outputs = list(getattr(agent, "_api_output_history", None) or [])
+        n = min(len(latencies), len(outputs))
+        samples = [(_number(o), _number(s, positive=True)) for o, s in zip(outputs[-n:], latencies[-n:])] if n else []
+        newest = "request"
+    if not samples or any(t is None or s is None for t, s in samples):
+        return None, None
+    duration = sum(s for _, s in samples)
+    rate = sum(t for t, _ in samples) / duration if duration > 0 else 0
+    return (rate, newest) if 0 < rate < 1e6 else (None, None)
+
+
+def capture_stream_timings(chunk, previous):
+    """Retain the final cumulative timing frame, including a choiceless usage frame."""
+    terminal = _field(chunk, "usage") or any(
+        _field(choice, "finish_reason") for choice in (_field(chunk, "choices") or ()))
+    return (_field(chunk, "timings") or previous) if terminal else previous
+
+
+def attach_stream_timings(response, timings, *, runaway=False):
+    """Incomplete/cancelled streams must not acquire a completed generation sample."""
+    from hermes_constants import PARTIAL_STREAM_STUB_ID
+
+    if not runaway and getattr(response, "id", None) != PARTIAL_STREAM_STUB_ID and timings is not None:
+        response.timings = timings
diff --git a/agent/local_request_scheduler.py b/agent/local_request_scheduler.py
new file mode 100644
index 00000000..d32b7da8
--- /dev/null
+++ b/agent/local_request_scheduler.py
@@ -0,0 +1,281 @@
+"""Schedule managed model attempts before their transport watchdog starts.
+
+Tool work remains concurrent. Permits cover stream consumption and surviving
+request workers, including protected auxiliary callbacks that outlive cancellation.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from contextvars import ContextVar
+from functools import wraps
+import logging
+import threading
+import time
+
+from hermes_cli.local_runtime.request_queue import QueueExpired
+from hermes_cli.local_runtime.request_target import bounded_number, resolve_target
+
+logger = logging.getLogger(__name__)
+_current: ContextVar[Lease | None] = ContextVar("local_model_admission", default=None)
+
+
+class Lease:
+    def __init__(self, target, *, background=False):
+        self.target = target
+        self.queue = target.queue()
+        self.token = self.queue.enqueue(target.model, background=background)
+        self.started = time.monotonic()
+        self.admitted = None
+        self.workers = []
+        self.requests = []
+        self.finished = False
+
+    def acquire(self, cancelled=lambda: False, progress=lambda message: None):
+        timeout = bounded_number(self.target.settings.get("queue_timeout_seconds"), 3600, 1, 86400)
+        last_notice = float("-inf")
+        drain_probe_at = float("-inf")
+        pressure_at, pressured, reason = float("-inf"), False, ""
+        try:
+            while True:
+                if cancelled():
+                    raise InterruptedError("Canceled while waiting for the local model; no request was sent.")
+                if not self.target.valid():
+                    raise QueueExpired("Managed model server changed while queued; no request was sent.")
+                if time.monotonic() - self.started >= timeout:
+                    raise QueueExpired("Local model queue deadline reached; no request was sent.")
+                if time.monotonic() - drain_probe_at >= 1:
+                    for token, model in self.queue.draining():
+                        if self.target.idle(model):
+                            self.queue.clear_drained([token])
+                    drain_probe_at = time.monotonic()
+                if time.monotonic() - pressure_at >= 1:
+                    from hermes_cli.local_runtime.adaptive_resources import admission_pressure
+
+                    pressured, reason = admission_pressure()
+                    pressure_at = time.monotonic()
+                if not pressured and self.queue.try_admit(self.token):
+                    self.admitted = time.monotonic()
+                    logger.info("Local model admission: queue_wait_ms=%.0f capacity=%d",
+                                1000 * (self.admitted - self.started), self.target.slots)
+                    return
+                if time.monotonic() - last_notice >= 5:
+                    progress("Waiting for " + reason if pressured else "Waiting in local model queue")
+                    last_notice = time.monotonic()
+                threading.Event().wait(0.25)
+        except BaseException:
+            self.queue.finish(self.token)
+            raise
+
+    def _threads(self):
+        threads = list(self.workers)
+        for request in self.requests:
+            thread = getattr(request, "worker", None) or getattr(request, "thread", None)
+            if thread is not None:
+                threads.append(thread)
+        return [thread for thread in threads if thread is not threading.current_thread() and thread.is_alive()]
+
+    def finish(self, *, uncertain=False):
+        if self.finished:
+            return
+        self.finished = True
+        uncertain = uncertain or any(
+            bool(getattr(request, "result", {}).get("error")) or bool(getattr(request, "cancelled", False))
+            for request in self.requests)
+        threads = self._threads()
+        if threads:
+            from agent.memory_provider import spawn_context_thread
+
+            def drain():
+                for thread in threads:
+                    thread.join()
+                self.queue.finish(self.token, uncertain=True)
+
+            spawn_context_thread(drain, name="local-admission-drain").start()
+        else:
+            self.queue.finish(self.token, uncertain=uncertain)
+        if self.admitted is not None:
+            logger.info("Local model admission finished: request_ms=%.0f draining=%s",
+                        1000 * (time.monotonic() - self.admitted), bool(threads) or uncertain)
+
+
+def track_request(request):
+    lease = _current.get()
+    if lease is not None:
+        lease.requests.append(request)
+
+
+def track_thread(thread):
+    lease = _current.get()
+    if lease is not None:
+        lease.workers.append(thread)
+
+
+def network_retry_limit(default: int) -> int:
+    """Managed failures re-enter admission after cleanup instead of racing orphaned work."""
+    return 0 if _current.get() is not None else default
